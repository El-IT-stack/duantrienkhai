# các mật khẩu mặc định để đảm bảo tiêu chí Hardening an toàn hệ thống.

# 1. DATABASE POSTGRESQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=project_management_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=StrongP@ssw0rd_2026_Secure!

# 2. BACKEND API (NestJS)
PORT=3000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_project_management_2026_xyz987
JWT_EXPIRATION=7d
CORS_ORIGIN=*

# 3. PGADMIN (Quản trị Web Database)
PGADMIN_DEFAULT_EMAIL=admin@pm.com
PGADMIN_DEFAULT_PASSWORD=PgAdmin@2026_Secure!
PGADMIN_PORT=5050

# 4. MONITORING (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Grafana@2026_Secure!
CADVISOR_PORT=8080

# 5. LOGGING (Loki & Promtail)
LOKI_PORT=3100

# 6. NGINX REVERSE PROXY
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
